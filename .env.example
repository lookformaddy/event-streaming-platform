# Event Streaming Platform — environment template
# Copy to .env and adjust. No secrets are needed: the engine is a fully
# offline, in-process broker, so the platform runs with no credentials.
ESP_DEFAULT_PARTITIONS=4
ESP_DEFAULT_RETENTION_MS=86400000
ESP_MAX_RECORDS_PER_PARTITION=100000
ESP_MAX_DELIVERY_ATTEMPTS=3
ESP_LAG_ALERT_THRESHOLD=100
ESP_P95_LATENCY_TARGET_MS=500
ESP_DLQ_RATE_THRESHOLD=0.01
ESP_QUARANTINE_RATE_THRESHOLD=0.05
ESP_HOST=0.0.0.0
ESP_PORT=8000
# ESP_CHECKPOINT_PATH=/var/lib/eventstream/checkpoints.json
